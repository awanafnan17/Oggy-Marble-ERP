APP_NAME="Oggy Marble ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# MySQL example (uncomment and replace locally when needed)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=oggy_erp
# DB_USERNAME=oggy_app
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

COMPANY_NAME="Oggy Marble"
COMPANY_ADDRESS="Configured business address"
COMPANY_PHONE=
COMPANY_NTN=
COMPANY_STRN=

OGGY_SUPERADMIN_EMAIL=admin@example.test
OGGY_SUPERADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
